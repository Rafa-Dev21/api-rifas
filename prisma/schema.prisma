generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  tickets Ticket[]

  wonRifas Rifa[] @relation("Winner")
}

model Rifa {
  id           Int      @id @default(autoincrement())
  title        String
  description  String
  price        Float
  totalNumbers Int
  createdAt    DateTime @default(now())

  winnerId Int?
  winner   User? @relation("Winner", fields: [winnerId], references: [id])

  tickets Ticket[]
}

model Ticket {
  id     Int     @id @default(autoincrement())
  number Int
  isSold Boolean @default(false)

  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  rifaId Int
  rifa   Rifa @relation(fields: [rifaId], references: [id])

  @@unique([number, rifaId])
}
